# Copy to .env.local and fill values when you have them.
# Never commit .env.local itself.

# Supabase (auth + DB) — paste from project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side service role (for waitlist writes from API routes)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (when pricing goes live)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Anthropic Claude API (for questionnaire drafting later)
ANTHROPIC_API_KEY=
