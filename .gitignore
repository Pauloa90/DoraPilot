# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local

# vercel / netlify local artifacts
.vercel
.netlify

# local data (waitlist signups before Supabase is wired)
/.data

# Claude Code session artifact (chat-latest.html is local-only,
# never deploy our internal conversation to production)
/public/chat-latest.html

# typescript
*.tsbuildinfo
next-env.d.ts
